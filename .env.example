# Environment variables for the Denny Warriors website.
#
# IMPORTANT: every VITE_ variable is copied into the JavaScript that visitors
# download, so anyone can read it. Never put a password, token or private
# API key in a VITE_ variable, here or in Vercel.
#
# For local development, copy this file to .env.local (git ignores it).

# Optional. Address of the API, used only if public/runtime-config.js
# doesn't set one. Production is configured in public/runtime-config.js.
# VITE_API_URL=http://localhost:8080/api/v1

# Optional. Only change if the API's login route moves.
# VITE_ADMIN_LOGIN_PATH=/auth/login
